void main(){
	uint DID=gl_GlobalInvocationID.x;
    uint GID=gl_WorkGroupID.x;
    
    float deltaX=rand(vec2(float(DID),5.2102))*64.0;

    vec3 result_velocity=vec3(
        50.0*(perlinNoise(vec2(float(DID),0.123)+vec2(_time+deltaX))*2.0-1.0)*cos(float(DID)+_time+deltaX),
        50.0*(perlinNoise(vec2(0.971,float(DID))+vec2(_time+deltaX))*2.0-1.0)*sin(float(DID)+_time+deltaX),
        50.0*(perlinNoise(vec2(float(DID))      +vec2(_time+deltaX))*2.0-1.0)*sin(float(DID)+_time+deltaX)
    );

    float radius=3.5;
    result_velocity+=normalize(result_velocity)*radius;

    outBufferBoidsForce.boidsForce[DID].force=vec3(
        (isnan(result_velocity.x))?0.005:result_velocity.x,
        (isnan(result_velocity.y))?0.005:result_velocity.y,
        (isnan(result_velocity.z))?0.005:result_velocity.z
    );

}
